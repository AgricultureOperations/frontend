# Public, browser-visible URLs only (baked into the JS bundle at build time). Never put secrets here.
# Local dev: backends on localhost. Production builds get these from GitHub Actions secrets.
# Leave VITE_BITACORA_BASE_URL empty to call auth-service through the Vite dev proxy (vite.config.ts).
VITE_BITACORA_BASE_URL=http://localhost:3000
VITE_ORDERSERVICE_BASE_URL=http://localhost:8080
